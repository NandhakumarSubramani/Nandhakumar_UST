@model List<HealthApp.Models.HealthRecord>

<h2 class="text-primary mb-3">Health Records</h2>

<div class="mb-3">
    <a href="/HealthRecord/Create" class="btn btn-success">Add New Record</a>
</div>

<div class="card p-3 mb-3 shadow">
    <form method="get" action="/HealthRecord/GetRecordsByDoctorAndPatient">
        <div class="row">
            <div class="col-md-4">
                <label>Doctor Id</label>
                <input type="number" name="doctorId" class="form-control" />
            </div>
            <div class="col-md-4">
                <label>Patient Id</label>
                <input type="number" name="patientId" class="form-control" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </div>
    </form>
</div>

<table class="table table-bordered table-striped table-hover">
    <thead class="thead-dark">
        <tr>
            <th>Record Id</th>
            <th>Patient Name</th>
            <th>Doctor Name</th>
            <th>Visit Date</th>
            <th>Diagnosis</th>
            <th>Prescription</th>
            <th>Notes</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.RecordId</td>
                <td>@item.Patient.FullName</td>
                <td>@item.Doctor.FullName</td>
                <td>@item.VisitDate.ToString("yyyy-MM-dd")</td>
                <td>@item.Diagnosis</td>
                <td>@item.Prescription</td>
                <td>@item.Notes</td>
            </tr>
        }
    </tbody>
</table>