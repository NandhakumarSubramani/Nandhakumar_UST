@model HealthApp.Models.HealthRecord

<h2 class="mb-3">Add New Health Record</h2>

<div class="card shadow p-4">
    @using (Html.BeginForm())
    {
        <div class="form-group">
            <label>Patient Id</label>
            <input type="number" name="PatientId" class="form-control" />
        </div>

        <div class="form-group mt-2">
            <label>Doctor Id</label>
            <input type="number" name="DoctorId" class="form-control" />
        </div>

        <div class="form-group mt-2">
            <label>Visit Date</label>
            @Html.TextBoxFor(m => m.VisitDate, "{0:yyyy-MM-dd}",
                new { @class = "form-control", type = "date" })
        </div>

        <div class="form-group mt-2">
            <label>Diagnosis</label>
            @Html.TextBoxFor(m => m.Diagnosis, new { @class = "form-control" })
        </div>

        <div class="form-group mt-2">
            <label>Prescription</label>
            @Html.TextBoxFor(m => m.Prescription, new { @class = "form-control" })
        </div>

        <div class="form-group mt-2">
            <label>Notes</label>
            @Html.TextBoxFor(m => m.Notes, new { @class = "form-control" })
        </div>

        <div class="mt-3">
            <input type="submit" value="Save" class="btn btn-primary" />
            <a href="/HealthRecord/HealthRecordsIndex" class="btn btn-secondary">Back</a>
        </div>
    }
</div>