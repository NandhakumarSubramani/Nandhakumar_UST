@model HealthApp.Shared.DTOs.HealthRecordDto

<h2 class="text-primary mb-4">Add Health Record</h2>

<div class="card shadow p-4">

    @using (Html.BeginForm("CreateFromAppointment", "HealthRecord", FormMethod.Post))
    {
        @Html.HiddenFor(m => m.PatientId)
        @Html.HiddenFor(m => m.DoctorId)
        @Html.HiddenFor(m => m.VisitDate)

        <div class="mb-3">
            <label><b>Patient:</b></label>
            <p class="form-control-plaintext">@Model.PatientName</p>
        </div>

        <div class="mb-3">
            <label><b>Doctor:</b></label>
            <p class="form-control-plaintext">@Model.DoctorName</p>
        </div>

        <div class="mb-3">
            <label><b>Date:</b></label>
            <p class="form-control-plaintext">@Model.VisitDate.ToString("yyyy-MM-dd")</p>
        </div>

        <div class="mb-3">
            <label>Diagnosis</label>
            @Html.TextBoxFor(m => m.Diagnosis, new { @class = "form-control" })
        </div>

        <div class="mb-3">
            <label>Prescription</label>
            @Html.TextBoxFor(m => m.Prescription, new { @class = "form-control" })
        </div>

        <div class="mb-3">
            <label>Notes</label>
            @Html.TextBoxFor(m => m.Notes, new { @class = "form-control" })
        </div>

        <div class="mt-3">
            <input type="submit" value="Save" class="btn btn-primary" />
            <a href="/Appointment/AppointmentIndex" class="btn btn-secondary">Back</a>
        </div>
    }

</div>