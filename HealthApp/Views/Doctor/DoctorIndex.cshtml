@model List<HealthApp.Shared.DTOs.DoctorDto>

<h2 class="text-primary mb-3">Doctor Details</h2>

<div class="mb-3">
    <a href="/Doctor/Create" class="btn btn-success">
        Add New Doctor
    </a>
</div>

<!-- ✅ SEARCH -->
<div class="card p-3 mb-3 shadow">
    @using (Html.BeginForm("Search", "Doctor", FormMethod.Get))
    {
        <div style="display:flex; gap:10px;">
            <label><b>Search:</b></label>

            <input type="text"
                   name="query"
                   class="form-control"
                   placeholder="Enter name or ID" />

            <button type="submit" class="btn btn-primary">
                Search
            </button>
        </div>
    }
</div>

<!-- ✅ FILTER -->
<div class="card p-3 mb-3 shadow">
    @using (Html.BeginForm("SearchBySpecialisation", "Doctor", FormMethod.Get))
    {
        <div style="display:flex; gap:10px;">
            <label><b>Specialisation:</b></label>

            <select name="specialisation" class="form-control">
                <option value="">-- Select --</option>
                <option>Cardiologist</option>
                <option>Dermatologist</option>
                <option>Neurologist</option>
                <option>Pediatrician</option>
                <option>Orthopedic</option>
                <option>ENT</option>
                <option>Gynecologist</option>
            </select>

            <button type="submit" class="btn btn-primary">
                Filter
            </button>
        </div>
    }
</div>

<!-- ✅ TABLE -->
<table class="table table-bordered table-striped table-hover">
    <thead class="thead-dark">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Specialisation</th>
            <th>Experience</th>
            <th>Fee</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.DoctorId</td>
                    <td>@item.FullName</td>
                    <td>@item.Specialisation</td>
                    <td>@item.YearsOfExperience</td>
                    <td>@item.ConsultationFee</td>

                    <!-- ✅ STATUS -->
                    <td>
                        <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                            @(item.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>

                    <!-- ✅ TOGGLE BUTTON -->
                    <td>
                        <a href="/Doctor/ToggleStatus/@item.DoctorId"
                           class="btn btn-sm @(item.IsActive ? "btn-warning" : "btn-success")">

                            @(item.IsActive ? "Deactivate " : "Activate ")

                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center text-danger">
                    No doctors found
                </td>
            </tr>
        }
    </tbody>
</table>
