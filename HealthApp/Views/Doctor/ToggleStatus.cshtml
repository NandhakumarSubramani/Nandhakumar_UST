@model List<HealthApp.Models.Doctor>

@{
    ViewBag.Title = "Toggle Status";
}

<h2>Toggle Status</h2>

<table border="1">
    <tr>
        <th>Name</th>
        <th>Status</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.FullName</td>

            <td>
                @(item.IsActive ? "Active" : "Inactive")
            </td>

            <td>
                <a href="@Url.Action("ToggleStatus", "Doctor", new { id = item.DoctorId })">
                    Toggle Status
                </a>
            </td>
        </tr>
    }
</table>