
@{
    ViewBag.Title = "Create";
}


@model HealthApp.Models.Doctor

<h2 class="mb-3">Add Doctor</h2>

<div class="card shadow p-4">
    @using (Html.BeginForm())
    {
        <div class="form-group">
            <label>Name</label>
            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
        </div>

        <div class="form-group mt-2">
            <label>Specialisation</label>
            @Html.EnumDropDownListFor(m => m.Specialisation, new { @class = "form-control" })
        </div>

        <div class="form-group mt-2">
            <label>Phone</label>
            @Html.TextBoxFor(m => m.DoctorPhoneNo, new { @class = "form-control" })
        </div>

        <div class="form-group mt-2">
            <label>Email</label>
            @Html.TextBoxFor(m => m.DoctorEmail, new { @class = "form-control" })
        </div>

        <div class="form-group mt-2">
            <label>Experience</label>
            @Html.TextBoxFor(m => m.YearsOfExperience, new { @class = "form-control" })
        </div>

        <div class="form-group mt-2">
            <label>Consultation Fee</label>
            @Html.TextBoxFor(m => m.ConsultationFee, new { @class = "form-control" })
        </div>

        <div class="mt-3">
            <input type="submit" value="Save" class="btn btn-primary" />
            <a href="/Doctor/DoctorIndex" class="btn btn-secondary">Back</a>
        </div>
    }
</div>
