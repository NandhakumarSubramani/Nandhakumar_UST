@model HealthApp.Models.Doctor

@{
    ViewBag.Title = "Create";
}

<h2 class="mb-3">Add Doctor</h2>

<div class="card shadow p-4">

    @using (Html.BeginForm())
    {
        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

        <div class="form-group">
            <label>Name</label>
            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
        </div>

        <div class="form-group mt-2">
            <label>Specialisation</label>
            @Html.EnumDropDownListFor(m => m.Specialisation,
                "-- Select --",
                new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Specialisation, "", new { @class = "text-danger" })
        </div>

        <div class="form-group mt-2">
            <label>Phone</label>
            @Html.TextBoxFor(m => m.DoctorPhoneNo, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.DoctorPhoneNo, "", new { @class = "text-danger" })
        </div>

        <div class="form-group mt-2">
            <label>Email</label>
            @Html.TextBoxFor(m => m.DoctorEmail, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.DoctorEmail, "", new { @class = "text-danger" })
        </div>

        <div class="form-group mt-2">
            <label>Experience (Years)</label>
            @Html.TextBoxFor(m => m.YearsOfExperience,
                new { @class = "form-control", type = "number" })
            @Html.ValidationMessageFor(m => m.YearsOfExperience, "", new { @class = "text-danger" })
        </div>

        <div class="form-group mt-2">
            <label>Consultation Fee</label>
            @Html.TextBoxFor(m => m.ConsultationFee,
                new { @class = "form-control", type = "number", step = "0.01" })
            @Html.ValidationMessageFor(m => m.ConsultationFee, "", new { @class = "text-danger" })
        </div>

        <div class="mt-3">
            <input type="submit" value="Save" class="btn btn-primary" />
            <a href="/Doctor/DoctorIndex" class="btn btn-secondary">Back</a>
        </div>
    }

</div>