@model List<HealthApp.Shared.DTOs.AppointmentDto>

<h2 class="text-primary mb-3">Appointment Details</h2>

<div class="mb-3">
    <a href="/Appointment/Create" class="btn btn-success">
        Book Appointment
    </a>
</div>

<!-- ✅ Search by Id -->
<div class="card p-3 mb-3 shadow">
    <form method="get" action="/Appointment/GetById">
        <input type="number" name="id" class="form-control" placeholder="Enter Id" />
        <button class="btn btn-primary mt-2">Search</button>
    </form>
</div>

<!-- ✅ TABLE -->
<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Id</th>
            <th>Patient</th>
            <th>Doctor</th>
            <th>Date</th>
            <th>Slot</th>
            <th>Status</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.AppointmentId</td>
                    <td>@item.PatientName</td>   <!-- ✅ FIX -->
                    <td>@item.DoctorName</td>    <!-- ✅ FIX -->
                    <td>@item.ScheduledDate.ToString("yyyy-MM-dd")</td>
                    <td>@item.TimeSlot</td>

                    <td>
                        <span class="badge
                            @(item.Status == "Confirmed" ? "bg-success" :
                              item.Status == "Cancelled" ? "bg-danger" :
                              item.Status == "Completed" ? "bg-info" :
                              "bg-warning")">
                            @item.Status
                        </span>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-danger text-center">
                    No appointments found
                </td>
            </tr>
        }
    </tbody>
</table>
