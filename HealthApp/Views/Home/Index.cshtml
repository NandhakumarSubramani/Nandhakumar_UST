@{
    ViewBag.Title = "Home";
}

<div class="container text-center mt-4">

    <h1 class="text-primary mb-4">Health Care App</h1>

    <div class="row justify-content-center">

        <div class="col-md-3 mb-3">
            <a href="/Patient/PatientIndex" class="text-decoration-none">
                <div class="card shadow p-4">
                    <h5 class="card-title">Patients</h5>
                </div>
            </a>
        </div>

        <div class="col-md-3 mb-3">
            <a href="/Doctor/DoctorIndex" class="text-decoration-none">
                <div class="card shadow p-4">
                    <h5 class="card-title">Doctors</h5>
                </div>
            </a>
        </div>

        <div class="col-md-3 mb-3">
            <a href="/HealthRecord/HealthRecordsIndex" class="text-decoration-none">
                <div class="card shadow p-4">
                    <h5 class="card-title">Health Records</h5>
                </div>
            </a>
        </div>

        <div class="col-md-3 mb-3">
            <a href="/Appointment/AppointmentIndex" class="text-decoration-none">
                <div class="card shadow p-4">
                    <h5 class="card-title">Appointments</h5>
                </div>
            </a>
        </div>

    </div>

</div>

<style>
    .card {
        border-radius: 15px;
        transition: 0.3s;
        cursor: pointer;
    }

        .card:hover {
            background-color: #e6f2ff;
            transform: scale(1.05);
        }
</style>