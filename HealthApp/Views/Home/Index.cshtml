@{
    ViewBag.Title = "Home";
}

<h1 style="text-align:center; color:darkblue;">Health Care App</h1>

<style>
    .container {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 40px;
        gap: 20px;
    }

    .card {
        width: 200px;
        height: 120px;
        background-color: #f2f2f2;
        border-radius: 10px;
        text-align: center;
        padding-top: 35px;
        font-size: 18px;
        font-weight: bold;
        box-shadow: 2px 2px 10px gray;
        transition: 0.3s;
    }

        .card:hover {
            background-color: #d0e7ff;
            transform: scale(1.05);
            cursor: pointer;
        }

    a {
        text-decoration: none;
        color: black;
    }
</style>

<div class="container">

    <a href="/Patient/PatientIndex">
        <div class="card">
            Patients
        </div>
    </a>

    <a href="/Doctor/DoctorIndex">
        <div class="card">
            Doctors
        </div>
    </a>

    <a href="/HealthRecord/HealthRecordsIndex">
        <div class="card">
            Health Records
        </div>
    </a>

    <a href="/Appointment/AppointmentIndex">
        <div class="card">
            Appointments
        </div>
    </a>

</div>
